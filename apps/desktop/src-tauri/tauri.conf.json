{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vibe Coding Remote",
  "version": "0.1.2",
  "identifier": "com.dray.vibecodingremote",
  "build": {
    "beforeDevCommand": "pnpm -w run build:web && pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm -w run build:web && pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vibe Coding Remote",
        "width": 980,
        "height": 820,
        "minWidth": 720,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../web/dist/": "mobile-web/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
